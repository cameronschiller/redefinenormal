---
import SectionHead from './SectionHead.astro';
const audiences = [
  { t: 'Corporate leadership', s: 'Corporate leadership & employee events' },
  { t: 'Conferences', s: 'Conferences & professional associations' },
  { t: 'Universities', s: 'Universities & student organizations' },
  { t: 'Creative communities', s: 'Entrepreneurial & creative communities' },
  { t: 'Performance', s: 'Athletic & personal-development organizations' },
];
---
<section id="audiences" class="bg-paper py-24 md:py-36" aria-labelledby="aud-title">
  <div class="wrap grid grid-cols-4 gap-x-5 md:grid-cols-12 md:gap-x-6">
    <SectionHead index="05" label="Who It’s For" />
    <h2 id="aud-title" class="reveal display col-span-4 text-[2.6rem] md:col-span-9 md:text-[clamp(2.8rem,4.6vw,4.75rem)]">
      For any room ready to question its normal.
    </h2>
    <ul class="col-span-4 mt-16 md:col-span-12 md:mt-24">
      {audiences.map((a, i) => (
        <li class="reveal group relative border-t border-line-ink last:border-b" style={`--d:${i * 60}ms`}>
          <div class="relative z-10 grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 py-5 transition-colors duration-500 group-hover:text-paper md:grid-cols-[4rem_1fr_minmax(0,22rem)] md:py-6">
            <span class="label text-ash transition-colors group-hover:text-fog">0{i + 1}</span>
            <span class="display text-[9vw] uppercase md:text-[4.4vw] 2xl:text-[4.25rem]">{a.t}</span>
            <span class="col-start-2 mt-2 text-ash transition-colors group-hover:text-fog md:col-start-3 md:mt-0 md:text-right">{a.s}</span>
          </div>
          <span class="absolute inset-0 origin-bottom scale-y-0 bg-ink transition-transform duration-500 ease-[var(--ease-editorial)] group-hover:scale-y-100" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </div>
</section>
