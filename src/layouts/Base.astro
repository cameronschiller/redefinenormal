---
import '../styles/global.css';
import { site, withBase } from '../config/site';

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('assets/og/og-image.png'), Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.speaker,
  jobTitle: 'Keynote Speaker',
  url: canonical.href,
  knowsAbout: ['Keynote speaking', 'Endurance sport', 'Creative production'],
};
---
<!doctype html>
<html lang="en" class:list={['no-js', { 'review-on': site.reviewMode }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Redefine Normal — an interactive keynote by Cameron Schiller" />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!site.reviewMode ? null : <meta name="robots" content="noindex" />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {site.analytics.plausibleDomain && (
      <script is:inline defer data-domain={site.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a href="#main" class="label fixed left-4 top-4 z-[100] -translate-y-24 bg-ink px-4 py-3 text-paper focus:translate-y-0">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
