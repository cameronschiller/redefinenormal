---
const year = new Date().getFullYear();
---
<footer class="on-ink overflow-hidden bg-ink pt-20 text-paper md:pt-28">
  <div class="wrap">
    <div class="grid gap-10 border-t border-line-paper pt-6 md:grid-cols-12 md:gap-6">
      <p class="lede text-3xl md:col-span-6 md:text-4xl">Normal is where you start. Not where you have to stay.</p>
      <nav class="md:col-span-3 md:col-start-8" aria-label="Footer">
        <ul class="label space-y-3 text-fog">
          <li><a class="hover:text-paper" href="#idea">Transformation</a></li>
          <li><a class="hover:text-paper" href="#method">The Method</a></li>
          <li><a class="hover:text-paper" href="#experience">The Keynote</a></li>
          <li><a class="hover:text-paper" href="#speaker">The Speaker</a></li>
          <li><a class="hover:text-paper" href="#book">Booking</a></li>
        </ul>
      </nav>
      <div class="label space-y-3 text-fog md:col-span-2 md:text-right">
        <p>© {year} Cameron Schiller</p>
        <p><a class="hover:text-paper" href="#top">Back to top ↑</a></p>
      </div>
    </div>
  </div>
  <p class="display mt-16 select-none whitespace-nowrap pb-[1.5vw] text-center text-[10.4vw] uppercase leading-[0.8] md:mt-24" aria-hidden="true">Redefine Normal</p>
</footer>
