# Copy to .env for local development. Every value here is optional.
# PUBLIC_* values are embedded in the client bundle — never put secrets here.

# Form endpoint that accepts a JSON POST and returns 2xx on success
# (e.g. Formspree: https://formspree.io/f/xxxxxxx). Public by design; no API key.
PUBLIC_FORM_ENDPOINT=

# Booking email shown on the site and used as a fallback contact.
PUBLIC_BOOKING_EMAIL=operatorathletemethod@gmail.com

# Privacy-friendly analytics (Plausible). Leave blank to load no analytics.
PUBLIC_PLAUSIBLE_DOMAIN=

# Show "needs approval" markers on unapproved copy and credentials.
# Set to "false" for launch once everything is approved.
PUBLIC_REVIEW_MODE=true

# Deployment (set as GitHub repository variables, not here, for production)
# SITE_URL=https://your-domain.com
# BASE_PATH=/
