---
const outcomes = [
  { t: 'A different perspective on limitations', d: 'Recognize how assumptions and familiar patterns can influence what we believe is possible.' },
  { t: 'A new understanding of transformation', d: 'Explore how meaningful change is built through choices, behaviors, and sustained commitment.' },
  { t: 'Principles they can apply', d: 'Discover ideas from the Operator-Athlete Method that connect ambition with practical execution.' },
  { t: 'A reason to begin', d: 'Leave with a personal challenge to reconsider what’s possible — and what it might take to pursue it.' },
];
---
<section id="outcomes" class="on-ink bg-ink py-24 text-paper md:py-36" aria-labelledby="outcomes-title">
  <div class="wrap">
    <div class="mb-12 flex items-center justify-between border-t border-line-paper pt-4 md:mb-20">
      <p class="label text-fog">Intended audience takeaways</p>
    </div>
    <h2 id="outcomes-title" class="reveal display text-[12vw] uppercase md:text-[6.6vw] 2xl:text-[6.5rem]">What your audience<br /><span class="text-fog">takes away.</span></h2>
    <ol class="mt-20 grid gap-x-6 gap-y-12 sm:grid-cols-2 md:mt-28 lg:grid-cols-4">
      {outcomes.map((o, i) => (
        <li class="reveal border-t border-paper pt-5" style={`--d:${i * 90}ms`}>
          <span class="label text-fog">0{i + 1}</span>
          <h3 class="mt-8 text-xl font-semibold uppercase leading-tight tracking-[0.01em]">{o.t}</h3>
          <p class="mt-3 leading-relaxed text-fog">{o.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
